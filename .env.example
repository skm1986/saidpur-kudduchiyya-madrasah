# Saidpur kudduchiyya madrasah — Server Environment Variables
# Copy this file to ".env" on your Windows/Linux host and fill in your credentials.

# =====================================================================
# 1. REAL GMAIL / EMAIL OTP DELIVERY (for farhan786pc@gmail.com & Staff)
# Recommended: Create a 16-character Gmail App Password at:
#   Google Account -> Security -> 2-Step Verification -> App Passwords
# =====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=farhan786pc@gmail.com
SMTP_PASS=

# Optional alternative email provider (Resend API)
RESEND_API_KEY=
EMAIL_FROM=

# =====================================================================
# 2. REAL MOBILE SMS OTP DELIVERY (for 7797383198 & Staff Mobiles)
# Configure ANY ONE of the following SMS providers:
# =====================================================================
# Option A: Fast2SMS (India +91 numbers like 7797383198)
FAST2SMS_API_KEY=

# Option B: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option C: Custom JSON HTTP SMS Gateway (BulkSMSBD / SSLWireless / etc.)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=SKMADRASA

# =====================================================================
# 3. OPTIONAL POSTGRESQL DATABASE (Leave blank for Local JSON-ACID mode)
# =====================================================================
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Optional custom persistent directory for offline/local storage
SKM_DATA_DIR=
# Offline PC fallback: ONLY when internet/SMTP cannot reach Gmail on local host (localhost),
# setting this to "true" allows User ID + Password login without OTP. Keep "false" on public online servers.
SKM_ALLOW_OFFLINE_LOCAL_LOGIN=true
SESSION_SECRET=
PORT=3000
